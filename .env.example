# Copier ce fichier en `.env` à la racine (et dans apps/api) : `cp .env.example .env`
# --- API ---
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://kwatro:kwatro@localhost:5469/kwatro?schema=public
CORS_ORIGINS=http://localhost:3010,http://localhost:8081
# Dev uniquement : l'en-tête `x-dev-user-id: <id d'un User>` vaut connexion (remplacé par Better Auth, KWT-9)
DEV_AUTH_HEADER=true

# --- Site web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- App mobile (Expo) ---
# Sur téléphone physique, remplacer localhost par l'IP locale de l'ordinateur
EXPO_PUBLIC_API_URL=http://localhost:3000
