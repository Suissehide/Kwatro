# Variables du déploiement Dokploy (deploy/dokploy/docker-compose.dokploy.yml),
# à renseigner dans l'onglet Environment du service. Ne jamais committer les vraies valeurs.

# Images
APP_IMAGE_NAME=kwatro
VERSION=0.1.0

# API
# Origines autorisées (site public + app web), séparées par des virgules
CORS_ORIGINS="https://kwatro.example.com,https://app.kwatro.example.com"
# URL publique de l'API (base des retours Apple / Google : <URL>/api/auth/callback/google|apple)
BETTER_AUTH_URL="https://api.kwatro.example.com"
# Secret obligatoire, 32 caractères min. : `openssl rand -base64 32`
BETTER_AUTH_SECRET=CHANGE_ME
# Connexion Google / Apple (facultatif, cf. .env.example à la racine)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Site (Next.js) : URL publique de l'API, figée au build
NEXT_PUBLIC_API_URL="https://api.kwatro.example.com"
# Site (Next.js) : URL publique du site (canonique, sitemap, partage), figée au build
NEXT_PUBLIC_SITE_URL="https://kwatro.example.com"

# App web (Expo) : URL publique de l'API, figée au build
EXPO_PUBLIC_API_URL="https://api.kwatro.example.com"

# Postgres (PostGIS)
POSTGRES_USER=kwatro
# Secret : générer une valeur aléatoire, ex. `openssl rand -hex 32`
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_NAME=kwatro
