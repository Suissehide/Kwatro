  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "up"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/games": {
      "get": {
        "operationId": "GamesController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "TCG",
                          "BOARD_GAME"
                        ]
                      },
                      "minPlayers": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "maxPlayers": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "formats": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "slug": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "slug",
                            "name"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "slug",
                      "name",
                      "kind",
                      "minPlayers",
                      "maxPlayers",
                      "formats"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        },
        "tags": [
          "games"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "UsersController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "pseudo": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "PLAYER",
                        "VENUE_STAFF",
                        "ADMIN"
                      ]
                    },
                    "city": {
                      "nullable": true,
                      "type": "string"
                    },
                    "xp": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "id",
                    "email",
                    "pseudo",
                    "role",
                    "city",
                    "xp"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "users"
        ]
      }
    },
    "/waitlist": {
      "post": {
        "operationId": "WaitlistController_join",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "digitalMajority": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "email",
                  "digitalMajority"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "tags": [
          "waitlist"
        ]
      }
    }
