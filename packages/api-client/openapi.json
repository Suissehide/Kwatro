                  "city": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "digitalMajority": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "email",
                  "digitalMajority"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "tags": [
          "waitlist"
        ]
      }
    }
