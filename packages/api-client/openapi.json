    "/venues": {
      "get": {
        "operationId": "ExploreController_venues",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radiusKm",
            "required": false,
            "in": "query",
            "schema": {
              "default": 10,
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "GAME_BAR",
                          "TCG_SHOP",
                          "LUDOTHEQUE",
                          "ASSOCIATION",
                          "OTHER"
                        ]
                      },
                      "address": {
                        "type": "string"
                      },
                      "latitude": {
                        "type": "number"
                      },
                      "longitude": {
                        "type": "number"
                      },
                      "isPartner": {
                        "type": "boolean"
                      },
                      "kwatroPerk": {
                        "nullable": true,
                        "type": "string"
                      },
                      "distanceMeters": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "openNow": {
                        "nullable": true,
                        "type": "boolean"
                      },
                      "closesAtMinute": {
                        "nullable": true,
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "upcomingEventCount": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "id",
                      "slug",
                      "name",
                      "type",
                      "address",
                      "latitude",
                      "longitude",
                      "isPartner",
                      "kwatroPerk",
                      "distanceMeters",
                      "openNow",
                      "closesAtMinute",
                      "upcomingEventCount"
                    ]
                  }
                }
              }
            }
          }
        },
        "tags": [
          "explore"
        ]
      }
    },
    "/events": {
      "get": {
        "operationId": "ExploreController_events",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radiusKm",
            "required": false,
            "in": "query",
            "schema": {
              "default": 10,
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true,
              "maximum": 50
            }
          },
          {
            "name": "days",
            "required": false,
            "in": "query",
            "schema": {
              "default": 7,
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "GAME_NIGHT",
                          "INITIATION",
                          "TOURNAMENT",
                          "PRERELEASE",
                          "THEMED"
                        ]
                      },
                      "startsAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      "priceCents": {
                        "nullable": true,
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "capacity": {
                        "nullable": true,
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "registeredCount": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "registrationMode": {
                        "type": "string",
                        "enum": [
                          "NONE",
                          "IN_APP",
                          "EXTERNAL"
                        ]
                      },
                      "games": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "slug": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "slug",
                            "name"
                          ]
                        }
                      },
                      "venue": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "isPartner": {
                            "type": "boolean"
                          },
                          "distanceMeters": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
                          "slug",
                          "name",
                          "isPartner",
                          "distanceMeters"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "type",
                      "startsAt",
                      "priceCents",
                      "capacity",
                      "registeredCount",
                      "registrationMode",
                      "games",
                      "venue"
                    ]
                  }
                }
              }
            }
          }
        },
        "tags": [
          "explore"
        ]
      }
    },
