{
  "name": "@lucko/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Client typé de l'API Lucko, généré depuis son OpenAPI (app Expo + site Next.js)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.0",
    "typescript": "~6.0.3"
  }
}
