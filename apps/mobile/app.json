{
  "expo": {
    "name": "Kwatro",
    "slug": "kwatro",
    "scheme": "kwatro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.kwatro.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.kwatro.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kwatro utilise ta position pour te montrer les lieux et les soirées de jeu autour de toi."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
