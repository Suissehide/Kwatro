// Schéma initial Kwatro. Voir Obsidian « Architecture fonctionnelle — app joueurs » §16.
// Après modification : `pnpm db:migrate` (crée la migration) puis commit du dossier migrations/.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Joueurs ----------

enum UserRole {
  PLAYER
  VENUE_STAFF
  ADMIN
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  /// Nom transmis par Apple / Google (champ `name` de Better Auth), jamais montré aux autres joueurs
  name               String    @default("")
  emailVerified      Boolean   @default(false)
  image              String?
  /// Choisi à l'onboarding (KWT-45) : null juste après la création du compte
  pseudo             String?   @unique
  /// Saisie à l'inscription par e-mail, demandée après une première connexion Apple / Google
  birthDate          DateTime? @db.Date
  role              UserRole  @default(PLAYER)
  city               String?
  searchRadiusKm     Int       @default(10)
  /// Compte parent lié (mineurs de 13-14 ans)
  parentId           String?
  parent             User?     @relation("ParentChild", fields: [parentId], references: [id])
  children           User[]    @relation("ParentChild")
  parentalConsentAt  DateTime?
  xp                 Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  gameProfiles     PlayerGameProfile[]
  hostedRooms      Room[]              @relation("RoomHost")
  participations   RoomParticipant[]
  visits           Visit[]
  staffOf          VenueStaff[]
  eventRegistrations EventRegistration[]
  sessions           Session[]
  accounts           Account[]
}

// ---------- Auth (tables Better Auth, KWT-9) ----------

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Moyen de connexion : `credential` (e-mail + mot de passe haché), `apple` ou `google`
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Jeux ----------

enum GameKind {
  TCG
  BOARD_GAME
}

model Game {
  id         String       @id @default(cuid())
  slug       String       @unique
  name       String
  kind       GameKind
  minPlayers Int          @default(2)
  maxPlayers Int          @default(4)
  formats    GameFormat[]
  rooms      Room[]
  events     Event[]      @relation("EventGames")
  /// Lieux où ce jeu est disponible sur place
  venues     Venue[]      @relation("VenueGames")
}

model GameFormat {
  id       String              @id @default(cuid())
  slug     String
  name     String
  gameId   String
  game     Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  profiles PlayerGameProfile[]
  rooms    Room[]

  @@unique([gameId, slug])
}

enum DeclaredLevel {
  BEGINNER
  INTERMEDIATE
  CONFIRMED
  EXPERT
}

/// Niveau d'un joueur sur un format TCG : Kwote (Elo, départ 1000) et fiabilité.
model PlayerGameProfile {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  formatId         String
  format           GameFormat    @relation(fields: [formatId], references: [id], onDelete: Cascade)
  declaredLevel    DeclaredLevel @default(INTERMEDIATE)
  kwote            Int           @default(1000)
  rankedGames      Int           @default(0)
  reliabilityPct   Int           @default(0)
  updatedAt        DateTime      @updatedAt

  @@unique([userId, formatId])
}

// ---------- Lieux ----------

enum VenueType {
  GAME_BAR
  TCG_SHOP
  LUDOTHEQUE
  ASSOCIATION
  OTHER
}

model Venue {
  id                         String       @id @default(cuid())
  slug                       String       @unique
  name                       String
  type                       VenueType
  address                    String
  city                       String
  latitude                   Float
  longitude                  Float
  /// Point PostGIS, rempli par une migration SQL / un trigger à partir de latitude/longitude
  location                   Unsupported("geography(Point, 4326)")?
  isPartner                  Boolean      @default(false)
  /// Bars (débits de boissons) : pas de moins de 16 ans non accompagnés
  acceptsUnaccompaniedMinors Boolean      @default(false)
  description                String?
  /// Droit de jeu par personne (centimes) ; null = gratuit ou non renseigné
  playFeeCents               Int?
  /// Consommation minimum par personne (centimes)
  minSpendCents              Int?
  /// Avantage Kwatro proposé aux joueurs (lieux partenaires), ex. « -10 % sur les boosters »
  kwatroPerk                 String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  staff        VenueStaff[]
  rooms        Room[]
  events       Event[]
  visits       Visit[]
  openingHours VenueOpeningHours[]
  /// Jeux disponibles sur place
  games        Game[]              @relation("VenueGames")

  @@index([city])
  @@index([location], type: Gist)
}

/// Plage d'ouverture hebdomadaire ; plusieurs plages possibles le même jour.
/// Minutes depuis minuit ; closesAtMinute < opensAtMinute = fermeture après minuit.
model VenueOpeningHours {
  id             String @id @default(cuid())
  venueId        String
  venue          Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// 1 = lundi … 7 = dimanche (ISO 8601)
  weekday        Int
  opensAtMinute  Int
  closesAtMinute Int

  @@index([venueId])
}

enum VenueStaffRole {
  MANAGER
  STAFF
}

model VenueStaff {
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId String
  venue   Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  role    VenueStaffRole @default(STAFF)

  @@id([userId, venueId])
}

// ---------- Rooms ----------

enum RoomMode {
  RANKED
  CASUAL
}

enum RoomStatus {
  OPEN
  FULL
  CONFIRMED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Room {
  id            String     @id @default(cuid())
  hostId        String
  host          User       @relation("RoomHost", fields: [hostId], references: [id])
  gameId        String
  game          Game       @relation(fields: [gameId], references: [id])
  formatId      String?
  format        GameFormat? @relation(fields: [formatId], references: [id])
  mode          RoomMode   @default(CASUAL)
  status        RoomStatus @default(OPEN)
  venueId       String?
  venue         Venue?     @relation(fields: [venueId], references: [id])
  /// Domicile : seule une zone floue est publique ; adresse chiffrée, révélée 24 h avant
  atHome        Boolean    @default(false)
  homeAreaLabel String?
  homeAddressEncrypted String?
  startsAt      DateTime
  capacity      Int
  minorsAllowed Boolean    @default(false)
  autoAccept    Boolean    @default(false)
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  participants RoomParticipant[]

  @@index([startsAt])
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  WAITLISTED
  DECLINED
  LEFT
}

model RoomParticipant {
  roomId      String
  room        Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ParticipantStatus @default(PENDING)
  checkedInAt DateTime?
  createdAt   DateTime          @default(now())

  @@id([roomId, userId])
}

// ---------- Événements des lieux ----------

enum EventType {
  GAME_NIGHT
  INITIATION
  TOURNAMENT
  PRERELEASE
  THEMED
}

enum RegistrationMode {
  /// Entrée libre, pas d'inscription
  NONE
  /// Inscription dans l'app (places limitées par `capacity`)
  IN_APP
  /// Inscription sur un site externe (EventLink, HelloAsso…) via `externalUrl`
  EXTERNAL
}

/// Une occurrence datée. Un événement récurrent = plusieurs Event partageant le même `seriesId`
/// (chaque date a ses propres inscrits). Les occurrences sont créées à la saisie (back-office, seed).
model Event {
  id               String           @id @default(cuid())
  venueId          String
  venue            Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// Jeux concernés (vide = tous jeux, ex. soirée jeux de société libre)
  games            Game[]           @relation("EventGames")
  type             EventType
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime?
  capacity         Int?
  priceCents       Int?
  minAge           Int?
  registrationMode RegistrationMode @default(IN_APP)
  externalUrl      String?
  seriesId         String?
  cancelledAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  registrations EventRegistration[]

  @@index([venueId, startsAt])
  @@index([startsAt])
  @@index([seriesId])
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

/// Inscription d'un joueur à un événement (un seul enregistrement par joueur et par événement).
model EventRegistration {
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RegistrationStatus @default(REGISTERED)
  /// Présence pointée par le lieu (pointage, KWT-78)
  checkedInAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@id([eventId, userId])
  @@index([userId])
}

// ---------- Venues facturables ----------

enum VisitSource {
  QR_SCAN
  CHECK_IN
}

/// Une venue = un joueur dans un lieu un soir. Un seul forfait par joueur, par lieu et par soirée.
model Visit {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id])
  source        VisitSource
  /// Soirée de rattachement (date locale Europe/Paris)
  businessDate  DateTime    @db.Date
  spentCents    Int?
  billable      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([userId, venueId, businessDate])
}

// ---------- Liste d'attente (landing) ----------

/// Joueur inscrit à la liste d'attente du site, avant l'ouverture de l'app (KWT-3).
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  city      String?
  createdAt DateTime @default(now())
}
