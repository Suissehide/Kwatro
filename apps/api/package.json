{
  "name": "@kwatro/api",
  "version": "0.0.0",
  "private": true,
  "description": "API Kwatro (NestJS + PostgreSQL/PostGIS via Prisma)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "openapi": "tsc -p tsconfig.build.json --outDir .openapi && node .openapi/generate-openapi.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@kwatro/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
