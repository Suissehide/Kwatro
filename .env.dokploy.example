# Variables à renseigner dans Dokploy (onglet Environment du service Compose).
# Ne jamais committer les vraies valeurs.

# Domaines publics (DNS pointant vers le serveur)
API_DOMAIN=api.kwatro.fr
WEB_DOMAIN=kwatro.fr

# Base de données (mot de passe long et aléatoire : openssl rand -base64 32)
POSTGRES_USER=kwatro
POSTGRES_PASSWORD=
POSTGRES_DB=kwatro

# Traefik : à aligner sur la configuration du serveur
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
